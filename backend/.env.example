# Copy this to .env and fill in real values. Never commit the real .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://sgec_user:sgec_pass@localhost:5432/sgec?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# Storage adapter: "local" | "s3"
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads

# --- If STORAGE_DRIVER=s3 ---
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OTP delivery (swap fakeSender for real providers)
SMS_PROVIDER=console        # console | twilio
EMAIL_PROVIDER=console      # console | sendgrid
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=

# AI provider for recommendations / essay review / chat
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
